---
import { pages } from "../content.js";
import { css } from "../styles.js";
import { wixImage } from "../image-utils.js";

const { page } = Astro.props;
const canonicalPath = page.canonicalPath || page.path;
const canonical = new URL(canonicalPath === "/" ? "/" : `${canonicalPath.replace(/\/$/, "")}/`, Astro.site);
const socialImage = new URL(wixImage(page.image || "https://static.wixstatic.com/media/41554d_32408e731bb247e2b583c0320a2d4424~mv2.jpg", 1200, 85), Astro.site);
const navItems = pages.filter((item) => item.nav);
const pageHref = (path) => path === "/" ? "/" : `${path}/`;
const structuredData = page.structuredData || {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "TattooParlor"],
  name: "Agnes Hamilton Tattoos & Fine Art",
  url: "https://agneshamilton.com/",
  image: socialImage.href,
  email: "info@agneshamilton.com",
  address: {
    "@type": "PostalAddress",
    streetAddress: "3021 NE Broadway",
    addressLocality: "Portland",
    addressRegion: "OR",
    postalCode: "97232",
    addressCountry: "US",
  },
  sameAs: ["https://www.instagram.com/aggie.q.tattoo/", "https://www.facebook.com/agneshamiltontattoos/"],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={page.ogType || "website"} />
    <meta property="og:site_name" content="Agnes Hamilton Tattoos & Fine Art" />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={`${page.title} — Agnes Hamilton Tattoos & Fine Art`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.title} />
    <meta name="twitter:description" content={page.description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={`${page.title} — Agnes Hamilton Tattoos & Fine Art`} />
    <link rel="preconnect" href="https://static.wixstatic.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global set:html={css} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <span>Agnes Hamilton</span>
        <small>Tattoos &amp; Fine Art</small>
      </a>
      <nav aria-label="Main navigation">
        {navItems.map((item) => (
          <a href={pageHref(item.path)} aria-current={item.path === page.path ? "page" : undefined}>
            {item.nav}
          </a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>Agnes Hamilton Tattoos &amp; Fine Art, Portland, Oregon</p>
      <a href="mailto:info@agneshamilton.com">info@agneshamilton.com</a>
      <a href="https://www.instagram.com/aggie.q.tattoo/">Instagram</a>
    </footer>
  </body>
</html>
