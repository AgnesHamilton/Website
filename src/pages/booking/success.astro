---
import SiteLayout from "../../layouts/SiteLayout.astro";

const page = {
  path: "/booking",
  title: "Booking Request Received | Agnes Hamilton",
  description: "Your tattoo booking request has been sent to Agnes Hamilton.",
};
---

<SiteLayout page={page}>
  <section class="page-title confirmation">
    <h1>THANK YOU</h1>
    <p>Your booking request has been sent. Agnes will review the details and follow up by email.</p>
    <a class="button" href="/">RETURN HOME</a>
  </section>
</SiteLayout>
