---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";

const page = {
  path: "/upcoming-events",
  title: "Upcoming Events | Agnes Hamilton Tattoos & Fine Art",
  description: "Find upcoming Portland tattoo events, flash days, fundraisers and convention appearances with tattoo artist Agnes Hamilton and Anatomy Tattoo.",
};

const now = new Date();
const allEvents = (await getCollection("events"))
  .filter((event) => event.data.published)
  .sort((a, b) => a.data.start.valueOf() - b.data.start.valueOf());
const upcoming = allEvents.filter((event) => (event.data.end || event.data.start) >= now);
const past = allEvents.filter((event) => (event.data.end || event.data.start) < now).reverse();
const updates = (await getCollection("updates"))
  .filter((post) => post.data.published)
  .sort((a, b) => b.data.published_at.valueOf() - a.data.published_at.valueOf());
const formatEventDate = (event) => {
  const formatter = new Intl.DateTimeFormat("en-US", event.data.all_day
    ? { dateStyle: "long", timeZone: "America/Los_Angeles" }
    : { dateStyle: "long", timeStyle: "short", timeZone: "America/Los_Angeles" });
  return event.data.end ? formatter.formatRange(event.data.start, event.data.end) : formatter.format(event.data.start);
};
---

<SiteLayout page={page}>
  <section class="events-legacy-title"><h1>EVENTS, RAFFLES &amp;<br />FUNDRAISERS</h1></section>
  {upcoming.length > 0 && <section class="events-section cms-events">
      <h2>UPCOMING EVENTS</h2>
      <div class="events-list">
        {upcoming.map((event) => (
          <article class="event-card">
            {event.data.image && <a href={`/upcoming-events/${event.id}/`}><ResponsiveImage src={event.data.image} alt={event.data.image_alt || `${event.data.title} event artwork by Agnes Hamilton`} sizes="(max-width: 700px) 100vw, 330px" /></a>}
            <div class="event-copy">
              <p class="event-date">{formatEventDate(event)}</p>
              <h2><a href={`/upcoming-events/${event.id}/`}>{event.data.title}</a></h2>
              <p>{event.data.location}{event.data.address ? ` · ${event.data.address}` : ""}</p>
              <p>{event.data.summary}</p>
              <a class="button" href={`/upcoming-events/${event.id}/`}>EVENT DETAILS</a>
            </div>
          </article>
        ))}
      </div>
  </section>}
  {past.length > 0 && (
    <section class="events-section events-archive">
      <h2>PAST EVENTS</h2>
      <ul>{past.map((event) => <li><a href={`/upcoming-events/${event.id}/`}>{event.data.title}</a> <span>{formatEventDate(event)}</span></li>)}</ul>
    </section>
  )}
  {updates.length > 0 && (
    <section class="events-section legacy-feed">
      <h2>FROM THE ARCHIVE</h2>
      <div class="legacy-grid">
        {updates.map((post) => (
          <article class="legacy-card">
            {post.data.image && <a href={`/upcoming-events/archive/${post.id.replace(/^\d{4}-\d{2}-\d{2}-/, "")}/`}><ResponsiveImage src={post.data.image} alt={`${post.data.title} event artwork`} sizes="(max-width: 700px) 100vw, 315px" /></a>}
            <p class="event-date">{new Intl.DateTimeFormat("en-US", { dateStyle: "long" }).format(post.data.published_at)}</p>
            <h3><a href={`/upcoming-events/archive/${post.id.replace(/^\d{4}-\d{2}-\d{2}-/, "")}/`}>{post.data.title}</a></h3>
            <p>{post.data.summary}</p>
          </article>
        ))}
      </div>
    </section>
  )}
</SiteLayout>
