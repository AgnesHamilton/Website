---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../../layouts/SiteLayout.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("updates")).filter((post) => post.data.published);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/^\d{4}-\d{2}-\d{2}-/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const page = { path: "/upcoming-events", title: `${post.data.title} | Agnes Hamilton`, description: post.data.summary };
---

<SiteLayout page={page}>
  <article class="event-detail legacy-detail">
    <a class="event-back" href="/upcoming-events/">← EVENTS &amp; UPDATES</a>
    <h1>{post.data.title}</h1>
    <p class="event-date">{new Intl.DateTimeFormat("en-US", { dateStyle: "long" }).format(post.data.published_at)}</p>
    {post.data.image && <img src={post.data.image} alt="" />}
    <div class="event-body"><Content /></div>
  </article>
</SiteLayout>
