---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import ResponsiveImage from "../../../components/ResponsiveImage.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("updates")).filter((post) => post.data.published);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/^\d{4}-\d{2}-\d{2}-/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const archiveSlug = post.id.replace(/^\d{4}-\d{2}-\d{2}-/, "");
const page = {
  path: "/upcoming-events",
  canonicalPath: `/upcoming-events/archive/${archiveSlug}`,
  title: `${post.data.title} | Agnes Hamilton`,
  description: post.data.summary,
  image: post.data.image,
  ogType: "article",
};
---

<SiteLayout page={page}>
  <article class="event-detail legacy-detail">
    <a class="event-back" href="/upcoming-events/">← EVENTS &amp; UPDATES</a>
    <h1>{post.data.title}</h1>
    <p class="event-date">{new Intl.DateTimeFormat("en-US", { dateStyle: "long" }).format(post.data.published_at)}</p>
    {post.data.image && <ResponsiveImage src={post.data.image} alt={`${post.data.title} event artwork`} sizes="(max-width: 820px) 100vw, 820px" width={1280} loading="eager" fetchpriority="high" />}
    <div class="event-body"><Content /></div>
  </article>
</SiteLayout>
