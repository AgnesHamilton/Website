---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import ResponsiveImage from "../../components/ResponsiveImage.astro";

export async function getStaticPaths() {
  const events = (await getCollection("events")).filter((event) => event.data.published);
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const dateFormatter = new Intl.DateTimeFormat("en-US", event.data.all_day ? { dateStyle: "long" } : { dateStyle: "long", timeStyle: "short" });
const formattedDate = event.data.end ? dateFormatter.formatRange(event.data.start, event.data.end) : dateFormatter.format(event.data.start);
const page = {
  path: "/upcoming-events",
  canonicalPath: `/upcoming-events/${event.id}`,
  title: `${event.data.title} | Agnes Hamilton`,
  description: event.data.summary,
  image: event.data.image,
  imageAlt: event.data.image_alt,
  ogType: "article",
  structuredData: {
    "@context": "https://schema.org",
    "@type": "Event",
    name: event.data.title,
    description: event.data.summary,
    startDate: event.data.start.toISOString(),
    ...(event.data.end ? { endDate: event.data.end.toISOString() } : {}),
    eventStatus: "https://schema.org/EventScheduled",
    eventAttendanceMode: event.data.location === "Online fundraiser"
      ? "https://schema.org/OnlineEventAttendanceMode"
      : "https://schema.org/OfflineEventAttendanceMode",
    image: event.data.image ? [new URL(event.data.image, Astro.site).href] : undefined,
    url: new URL(`/upcoming-events/${event.id}/`, Astro.site).href,
    location: event.data.location === "Online fundraiser"
      ? { "@type": "VirtualLocation", url: event.data.event_url }
      : { "@type": "Place", name: event.data.location, address: event.data.address || event.data.location },
    organizer: event.data.organizer ? {
      "@type": "Organization",
      name: event.data.organizer,
      ...(event.data.event_url ? { url: event.data.event_url } : {}),
    } : undefined,
  },
};
---

<SiteLayout page={page}>
  <article class="event-detail">
    <a class="event-back" href="/upcoming-events/">← ALL EVENTS</a>
    <h1>{event.data.title}</h1>
    <p class="event-date">{formattedDate}</p>
    <p>{event.data.location}{event.data.address ? ` · ${event.data.address}` : ""}</p>
    {event.data.image && <ResponsiveImage src={event.data.image} alt={event.data.image_alt || `${event.data.title} event artwork by Agnes Hamilton`} sizes="(max-width: 820px) 100vw, 820px" width={1280} loading="eager" fetchpriority="high" />}
    <div class="event-body"><Content /></div>
    {event.data.event_url && <a class="button" href={event.data.event_url}>EVENT INFORMATION</a>}
  </article>
</SiteLayout>
